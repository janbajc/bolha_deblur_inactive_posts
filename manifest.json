{
    "manifest_version": 3,
    "name": "Bolha Deblur",
    "version": "1.1",
    "host_permissions": ["https://*.bolha.com/*"],
    "content_scripts": [
        {
            "matches": ["https://*.bolha.com/*"],
            "js": ["content.js"],
            "run_at": "document_end"
        }
    ]
}